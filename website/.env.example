# Get a key at https://you.com/platform  (Search, Extract, Answer, Research and the Inference Router all use it)
YDC_API_KEY=
# Optional: any model id from `curl https://api.you.com/v1/models -H "Authorization: Bearer $YDC_API_KEY"`
YDC_LLM_MODEL=kimi-k3

# Encrypts the session and Gmail cookies. Any long random string: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (Web application) for "Continue with Google" and "Connect Gmail".
# Add this site's callback as an authorised redirect URI: https://<your-domain>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: where the header's "Mobile app" button points (the phone app's deployment)
NEXT_PUBLIC_MOBILE_APP_URL=https://vetted-eight-sandy.vercel.app
